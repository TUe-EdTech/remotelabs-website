# Normalize all text files to LF in the repository; git converts on
# checkout as needed. Prevents phantom modifications caused by mixed
# CRLF/LF working trees (deploy/ artifacts are regenerated by builds
# running under different shells).
* text=auto

# Windows batch files require CRLF
*.bat text eol=crlf

# Binaries: never touch
*.mp4 binary
*.woff2 binary
*.jpg binary
*.jpeg binary
*.png binary
*.avif binary
*.ttf binary
*.ico binary
